<?xml version="1.0" encoding="utf-8"?>
<!--
    顶栏下方的渐隐。

    内容是从顶栏**底下**滚过去的，直接切一刀会看到「半张卡片被顶栏拦腰截断」。
    压一层「背景色 → 透明」的渐变，滚到一半的卡片就是淡出，不是硬切。

    ⚠️ 必须是渐变，不能用纯色块：这层画在顶栏之前（先在布局里声明），
       纯色块会把同样占这块区域的顶栏文字一起盖掉。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/surface_base"
        android:endColor="@android:color/transparent" />
</shape>