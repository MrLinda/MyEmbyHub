<?xml version="1.0" encoding="utf-8"?>
<!--
    详情页背景：左边压暗、右边透出来。

    为什么不能只给 backdrop 设 alpha：整张图半透明等于「灰蒙蒙一片」，
    左边文字压在上面还是看不清。这是「从黑到透明」的水平渐变，
    左半边几乎纯黑（正文都在这儿），右半边完全透明（剧照露出来）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="@color/surface_base"
        android:centerColor="@color/scrim_heavy"
        android:endColor="@android:color/transparent" />
</shape>