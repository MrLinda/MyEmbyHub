<?xml version="1.0" encoding="utf-8"?>
<!--
    剧集条目的底（详情页「选集」那一排）。

    三态分开写，因为电视上「焦点」和「已看过」是两回事：
      · focused   —— 遥控器现在停在这一集上（暖色底 + 描边，最显眼）
      · selected  —— 这是「接下来该看」的那一集（浅底，提醒从这儿接着看）
      · 默认      —— 未看过
    已看过的集不靠底色区分，靠标题变灰（见 episode_chip_text.xml）。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_container" />
            <corners android:radius="8dp" />
            <stroke
                android:width="2dp"
                android:color="@color/focus_border" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_pressed" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="@color/focus_border_muted" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_pressed" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_raised" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="@color/stroke_subtle" />
        </shape>
    </item>
</selector>