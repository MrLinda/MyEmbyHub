<?xml version="1.0" encoding="utf-8"?>
<!--
    输入框背景：1dp 细边，聚焦时边线转暖色。

    ⚠️ 这里**不能**用 layer-list「底部一条色块」的写法。
       layer-list 的 `<item android:gravity="bottom">` 只有在 item 给了明确高宽时才生效
       （`android:height` 是 API 23 才有的属性，4.3 用不了），
       不给的时候那条色块会铺满整个输入框 —— 实机上就是一整块琥珀色，
       字都看不清（踩过）。
       → 改成四边细框，聚焦变色，4.3 上行为确定。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_pressed" />
            <stroke android:width="1dp" android:color="@color/accent_muted" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_pressed" />
            <stroke android:width="1dp" android:color="@color/stroke_subtle" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>