<?xml version="1.0" encoding="utf-8"?>
<!--
    左侧导航项（类别 tab）：没有海报，只有文字 + 焦点底色。
    高度固定 56dp，焦点块才有稳定的节奏。

    「当前选中」用两样东西表达（见 bg_rail_item.xml 的 state_selected）：
    - 左侧 4dp 的暖色竖条（rail_indicator）
    - 标题变成暖色
    焦点框是另一个维度（遥控器走到哪儿），两者可以同时出现。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@drawable/bg_rail_item"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="18dp"
    android:paddingRight="16dp"
    android:layout_marginBottom="4dp">

    <View
        android:id="@+id/rail_indicator"
        android:layout_width="4dp"
        android:layout_height="28dp"
        android:layout_marginRight="12dp"
        android:background="@color/accent"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_item_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</LinearLayout>
