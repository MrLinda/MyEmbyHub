<?xml version="1.0" encoding="utf-8"?>
<!--
    详情页内容（放在 TvDialog 的面板里）。

    ⚠️ 背景和标题都由面板负责：面板已经有圆角卡片 + 暖色竖条标题栏，
    这里再自带一套背景/标题就会「双层壳」。
    按钮沿用对话框的按钮样式（`bg_dialog_btn` 系列）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/dt_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/dt_overview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:lineSpacingExtra="4dp"
        android:maxLines="8"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dt_play"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_dialog_btn"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:minWidth="180dp"
            android:text="播放"
            android:textColor="@color/dialog_btn_text"
            android:textSize="17sp" />

        <Button
            android:id="@+id/dt_episodes"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginLeft="12dp"
            android:background="@drawable/bg_dialog_btn_secondary"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:minWidth="140dp"
            android:text="剧集列表"
            android:textColor="@color/dialog_btn_text_secondary"
            android:textSize="17sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
