<?xml version="1.0" encoding="utf-8"?>
<!--
    主页居中悬浮登录窗。

    宽高由 LoginDialog 按屏幕尺寸动态设为 60%–80%（默认约 72% 宽、内容自适应高），
    在 960×540dp（4K/1080p TV）和 1280×720dp（乐视 4.3）上都能留出四周暗色背景，
    呈现明显的悬浮卡片层次。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_panel"
    android:orientation="vertical">

    <!-- 标题行：跟 TvDialog 完全同款（暖色竖条 + 标题 + 一句说明） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="24dp"
        android:paddingTop="16dp"
        android:paddingRight="24dp"
        android:paddingBottom="12dp">

        <View
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:background="@color/indicator_bar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:text="@string/login_title"
            android:textColor="@color/content_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/login_subtitle"
            android:textColor="@color/content_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke_subtle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="22dp"
        android:paddingTop="16dp"
        android:paddingRight="22dp"
        android:paddingBottom="4dp">

        <!-- ==================== 左：二维码（默认视图） ==================== -->
        <LinearLayout
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                style="@style/TvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/login_qr_hint"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:background="@color/qrcode_backdrop">

                <ImageView
                    android:id="@+id/img_qr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/login_qr_title"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/tv_qr_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="18dp"
                    android:text="@string/login_qr_creating"
                    android:textColor="@color/content_on_inverse"
                    android:textSize="14sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_qr_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/content_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_qr_refresh"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_login_btn_secondary"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:minWidth="156dp"
                android:nextFocusRight="@+id/et_server"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:singleLine="true"
                android:text="@string/login_qr_refresh"
                android:textColor="@color/dialog_btn_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="230dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:background="@color/stroke_subtle" />

        <!-- ==================== 右：电视端直接输入（兜底） ==================== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_form_title"
                android:textColor="@color/content_secondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_server"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_dialog_input"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="@string/hint_server"
                android:inputType="textUri"
                android:nextFocusDown="@+id/et_user"
                android:nextFocusLeft="@+id/btn_qr_refresh"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:singleLine="true"
                android:textColor="@color/content_primary"
                android:textColorHint="@color/content_secondary"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/et_user"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_dialog_input"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="@string/hint_user"
                android:inputType="text"
                android:nextFocusDown="@+id/et_pass"
                android:nextFocusLeft="@+id/btn_qr_refresh"
                android:nextFocusUp="@+id/et_server"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:singleLine="true"
                android:textColor="@color/content_primary"
                android:textColorHint="@color/content_secondary"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/et_pass"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_dialog_input"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="@string/hint_password"
                android:inputType="textPassword"
                android:nextFocusDown="@+id/btn_login"
                android:nextFocusLeft="@+id/btn_qr_refresh"
                android:nextFocusUp="@+id/et_user"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:singleLine="true"
                android:textColor="@color/content_primary"
                android:textColorHint="@color/content_secondary"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_login"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_dialog_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:minWidth="136dp"
                    android:nextFocusLeft="@+id/btn_qr_refresh"
                    android:nextFocusRight="@+id/btn_remember_pass"
                    android:nextFocusUp="@+id/et_pass"
                    android:paddingLeft="24dp"
                    android:paddingRight="24dp"
                    android:singleLine="true"
                    android:text="@string/btn_login"
                    android:textColor="@color/dialog_btn_text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/btn_remember_pass"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginLeft="12dp"
                    android:background="@drawable/bg_login_btn_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:nextFocusLeft="@+id/btn_login"
                    android:nextFocusUp="@+id/et_pass"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:singleLine="true"
                    android:text="☑ 记住密码"
                    android:textColor="@color/dialog_btn_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 状态行：正在等扫码 / 手机登录失败 / 登录已过期 -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        android:paddingLeft="24dp"
        android:paddingTop="10dp"
        android:paddingRight="24dp"
        android:paddingBottom="16dp"
        android:textColor="@color/content_secondary"
        android:textSize="14sp" />
</LinearLayout>
