<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 电视不需要软键盘，但 EditText 需要它才能输入 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      在线更新要把 APK 下载到 /sdcard/Download/，API 18 上写外置存储**必须**有这个权限，
      否则 FileOutputStream 直接抛 FileNotFoundException: (Permission denied)。
      电视是 Android 4.3，没有运行时权限机制，装机即授予。
    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- 扫码登录要显示电视的局域网 IP，需要读 WiFi DHCP 信息 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MyEmbyHub"
        android:hardwareAccelerated="true">

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.HomeActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".ui.DetailActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".ui.LibraryActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".ui.PlayerActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:theme="@style/Theme.MyEmbyHub" />

    </application>

</manifest>
